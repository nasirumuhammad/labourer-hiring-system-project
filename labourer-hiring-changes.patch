+import { ApiError } from "@/lib/api/api-error";
+import { jobsApi } from "@/lib/job";
+import type { Application, Job } from "@/types/job";
+import { cn } from "cn";
+
+const STATUS_VARIANT: Record<
+  Application["status"],
+  "default" | "secondary" | "success" | "outline"
+> = {
+  pending: "secondary",
+  accepted: "success",
+  rejected: "outline",
+  withdrawn: "outline",
+};
+
+function formatPay(job: Job): string {
+  const suffix = job.paymentType === "hourly" ? "/hr" : "";
+  return `₦${Number(job.minPay).toLocaleString()} – ₦${Number(job.maxPay).toLocaleString()}${suffix}`;
+}
+
+export function LabourerDashboard() {
+  const [applications, setApplications] = useState<Application[]>([]);
+  const [totalApplications, setTotalApplications] = useState(0);
+  const [latestJobs, setLatestJobs] = useState<Job[]>([]);
+  const [isLoading, setIsLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    async function load() {
+      try {
+        const [apps, jobs] = await Promise.all([
+          jobsApi.myApplications(1, 50),
+          jobsApi.list({ limit: 5, sort: "newest" }),
+        ]);
+        setApplications(apps?.data?.data ?? []);
+        setTotalApplications(apps?.data?.total ?? 0);
+        setLatestJobs(jobs?.data?.data ?? []);
+      } catch (err) {
+        setError(
+          err instanceof ApiError ? err.message : "Failed to load dashboard",
+        );
+      } finally {
+        setIsLoading(false);
+      }
+    }
+    load();
+  }, []);
+
+  const count = (status: Application["status"]) =>
+    applications.filter((a) => a.status === status).length;
+
+  const stats = [
+    { label: "Total applications", value: totalApplications },
+    { label: "Pending", value: count("pending") },
+    { label: "Accepted", value: count("accepted") },
+    { label: "Rejected", value: count("rejected") },
+  ];
+
+  return (
+    <div className="mx-auto flex w-full max-w-5xl flex-col gap-6 p-4">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div>
+          <h1 className="text-2xl font-bold">Welcome back</h1>
+          <p className="text-sm text-muted-foreground">
+            Track your applications and find your next job.
+          </p>
+        </div>
+        <Link href="/jobs" className={cn(buttonVariants())}>
+          Browse Jobs
+        </Link>
+      </div>
+
+      {error && <p className="text-sm text-destructive">{error}</p>}
+
+      <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
+        {stats.map((stat) => (
+          <Card key={stat.label} className="gap-1 p-4">
+            <p className="text-xs text-muted-foreground">{stat.label}</p>
+            <p className="text-2xl font-bold">{isLoading ? "–" : stat.value}</p>
+          </Card>
+        ))}
+      </div>
+
+      <div className="grid gap-6 md:grid-cols-2">
+        <section className="flex flex-col gap-3">
+          <div className="flex items-center justify-between">
+            <h2 className="font-semibold">Recent applications</h2>
+            <Link
+              href="/applications"
+              className="text-sm text-primary hover:underline"
+            >
+              View all
+            </Link>
+          </div>
+          {isLoading && (
+            <p className="text-sm text-muted-foreground">Loading...</p>
+          )}
+          {!isLoading && applications.length === 0 && (
+            <p className="text-sm text-muted-foreground">
+              You haven&apos;t applied to any jobs yet.
+            </p>
+          )}
+          {applications.slice(0, 5).map((application) => (
+            <Card
+              key={application.id}
+              className="flex-row items-center justify-between p-3"
+            >
+              <div className="min-w-0">
+                <p className="truncate text-sm font-medium">
+                  {application.job?.title ?? "Job"}
+                </p>
+                <p className="truncate text-xs text-muted-foreground">
+                  {application.job?.companyName}
+                </p>
+              </div>
+              <Badge variant={STATUS_VARIANT[application.status]}>
+                {application.status}
+              </Badge>
+            </Card>
+          ))}
+        </section>
+
+        <section className="flex flex-col gap-3">
+          <div className="flex items-center justify-between">
+            <h2 className="font-semibold">Latest jobs</h2>
+            <Link href="/jobs" className="text-sm text-primary hover:underline">
+              See more
+            </Link>
+          </div>
+          {!isLoading && latestJobs.length === 0 && (
+            <p className="text-sm text-muted-foreground">
+              No open jobs right now.
+            </p>
+          )}
+          {latestJobs.map((job) => (
+            <Link key={job.id} href={`/jobs/${job.id}`}>
+              <Card className="gap-1 p-3 transition-colors hover:bg-muted/50">
+                <p className="text-sm font-medium">{job.title}</p>
+                <p className="text-xs text-muted-foreground">
+                  {job.companyName}
+                  {job.location ? ` · ${job.location}` : ""}
+                </p>
+                <p className="text-xs font-medium text-primary">
+                  {formatPay(job)}
+                </p>
+              </Card>
+            </Link>
+          ))}
+        </section>
+      </div>
+    </div>
+  );
+}
