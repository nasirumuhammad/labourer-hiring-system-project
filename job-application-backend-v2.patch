+  Post,
+  Query,
+  UseGuards,
+} from '@nestjs/common';
+import { UserRole } from '@labour-hiring/enums';
+import { ApplicationService } from './application.service';
+import { ApplyJobDto } from './dto/apply-job.dto';
+import { JwtAuthGuard } from '@/auth/guards/jwt-auth.guard';
